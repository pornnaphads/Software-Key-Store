generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Cart {
  id        Int     @id @default(autoincrement()) @map("cart_id")
  quantity  Int
  userId    Int     @map("user_id")
  productId Int     @map("product_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([productId])
  @@index([userId])
  @@map("cart")
}

model Category {
  id       Int       @id @default(autoincrement()) @map("category_id")
  name     String    @map("category_name") @db.VarChar(100)
  products Product[]

  @@map("categories")
}

model Discount {
  id             Int      @id @default(autoincrement()) @map("discount_id")
  expirationDate DateTime @map("expiration_date") @db.DateTime(0)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  customerType   String?  @map("customer_type") @db.VarChar(50)
  startDate      DateTime @map("start_date") @db.DateTime(0)
  status         String   @db.VarChar(50)
  userId         Int      @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@map("discounts")
}

model OrderItem {
  id          Int          @id @default(autoincrement()) @map("order_detail_id")
  price       Decimal      @db.Decimal(10, 2)
  quantity    Int
  orderStatus String       @map("order_status") @db.VarChar(50)
  orderId     Int          @map("order_id")
  productId   Int          @map("product_id")
  userId      Int          @map("user_id")
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  productKeys ProductKey[]

  @@index([orderId])
  @@index([productId])
  @@index([userId])
  @@map("order_details")
}

model Order {
  id          Int         @id @default(autoincrement()) @map("order_id")
  createdAt   DateTime    @default(now()) @map("order_date") @db.Timestamp(0)
  total       Decimal     @map("total_price") @db.Decimal(10, 2)
  status      String      @map("order_status") @db.VarChar(50)
  giftMessage String?     @map("gift_message") @db.VarChar(100)
  userId      Int         @map("user_id")
  orderItems  OrderItem[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  payments    Payment[]

  @@index([userId])
  @@map("orders")
}

model Payment {
  id            Int       @id @default(autoincrement()) @map("payment_id")
  paymentDate   DateTime  @default(now()) @map("payment_date") @db.Timestamp(0)
  netAmount     Decimal   @map("net_amount") @db.Decimal(10, 2)
  slipImage     String?   @map("slip_image") @db.VarChar(255)
  paymentStatus String    @map("payment_status") @db.VarChar(50)
  orderId       Int       @map("order_id")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  receipts      Receipt[]

  @@index([orderId])
  @@map("payments")
}

model Product {
  id             Int          @id @default(autoincrement()) @map("product_id")
  price          Decimal      @db.Decimal(10, 2)
  stock          Int          @map("stock_quantity")
  image          String?      @map("image_url") @db.VarChar(255)
  key            String?      @map("product_key") @db.VarChar(100)
  name           String       @map("product_name") @db.VarChar(200)
  description    String?      @db.Text
  purchaseDate   DateTime?    @map("purchase_date") @db.DateTime(0)
  expirationDate DateTime?    @map("expiration_date") @db.DateTime(0)
  categoryId     Int          @map("category_id")
  cart           Cart[]
  orderItems     OrderItem[]
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  reviews        Review[]
  productKeys    ProductKey[]

  @@index([categoryId])
  @@map("products")
}

model ProductKey {
  id            Int        @id @default(autoincrement()) @map("key_id")
  productKey    String     @map("product_key") @db.VarChar(255)
  salesStatus   String     @map("sales_status") @db.VarChar(20)
  productId     Int?       @map("product_id")
  orderDetailId Int?       @map("order_detail_id")
  product       Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderDetail   OrderItem? @relation(fields: [orderDetailId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orderDetailId])
  @@map("product_keys")
}

model Receipt {
  id        Int      @id @default(autoincrement()) @map("receipt_id")
  netTotal  Decimal  @map("net_total") @db.Decimal(10, 2)
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamp(0)
  paymentId Int      @map("payment_id")
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([paymentId])
  @@map("receipts")
}

model Request {
  id           Int      @id @default(autoincrement()) @map("request_id")
  subject      String   @db.VarChar(200)
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamp(0)
  contactName  String   @map("contact_name") @db.VarChar(150)
  contactEmail String   @map("contact_email") @db.VarChar(150)
  details      String   @db.Text
  userId       Int?     @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onUpdate: Restrict)

  @@index([userId])
  @@map("requests")
}

model Review {
  id        Int      @id @default(autoincrement()) @map("review_id")
  rating    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model User {
  id             Int         @id @default(autoincrement()) @map("user_id")
  firstName      String      @map("first_name") @db.VarChar(100)
  lastName       String      @map("last_name") @db.VarChar(100)
  email          String      @unique @db.VarChar(150)
  role           String      @db.VarChar(50)
  password       String      @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  profilePicture String?     @map("profile_picture") @db.VarChar(255)
  cart           Cart[]
  discounts      Discount[]
  orderItems     OrderItem[]
  orders         Order[]
  requests       Request[]
  reviews        Review[]
  passwordResetOtps PasswordResetOtp[]
  chatConversations  ChatConversation[]

  @@map("users")
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  email      String
  otpHash    String    @db.Char(64)
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  expiresAt  DateTime
  attempts   Int       @default(0)
  lastSentAt DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email, createdAt])
  @@index([userId, consumedAt, expiresAt])
}

model ChatConversation {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String?
  status    String        @default("OPEN")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  senderRole     String
  content        String           @db.Text
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}
